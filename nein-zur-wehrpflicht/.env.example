# Upstash Redis (bei Vercel über Storage > Upstash Redis automatisch gesetzt)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Langer Zufallswert, z. B. `openssl rand -hex 32`
DEVICE_SECRET=
# Eigene Domain für Teilen-Links und Vorschaubilder, z. B. https://deine-domain.de
NEXT_PUBLIC_SITE_URL=
# Neue Geräte pro Internetanschluss und Tag (Schulen, Unis und Mobilfunk teilen sich Adressen)
MAX_NEW_DEVICES_PER_IP=150
# Abstimmungen pro Internetanschluss und Minute (Schutz vor Skripten)
MAX_VOTES_PER_IP_MINUTE=40
# 1 = ohne Datenbank keine Abstimmung annehmen (in der Vercel-Produktion automatisch so)
REQUIRE_DATABASE=
# Kontaktformular: Versand über ein E-Mail-Postfach (SMTP). Ohne SMTP_HOST verweist das Formular auf die E-Mail-Adresse.
# Port 465 (verschlüsselt) oder 587 (STARTTLS). Absender ist CONTACT_FROM, sonst SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Empfänger der Nachrichten (leer: die Adresse aus src/lib/contact.ts)
CONTACT_TO=
CONTACT_FROM=
