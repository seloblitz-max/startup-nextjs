# Gen Z steht auf: Regeln für den Webspace (Apache oder LiteSpeed, etwa bei Hostinger).
# Die Seiten sind fertige Dateien. PHP braucht es nur für die Abstimmung (api.php) und um die Adresse
# der Website in Seiten, Sitemap und Kalender einzusetzen (seite.php).

AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType font/woff .woff
AddType font/woff2 .woff2
AddCharset utf-8 .js .css .json .webmanifest .svg

RewriteEngine On

# Einstellungen und Datenbank sind nie von außen erreichbar.
RewriteRule ^_app(/|$) - [F,L]

# Zertifikate (SSL) und andere Dienste des Webhosters unverändert durchlassen.
RewriteRule ^\.well-known/ - [L]

# Abstimmung, Klickzähler und Kontaktformular
RewriteRule ^api(/|$) api.php [L]

# Seiten, Seiten-Daten für die Navigation, Sitemap und Kalender. Was es nicht gibt, beantwortet seite.php mit der 404-Seite.
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} !-f [OR]
RewriteCond %{REQUEST_URI} \.(html|txt|xml|ics)$ [NC]
RewriteRule ^ seite.php [L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "DENY"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
  <FilesMatch "^(icon\.png|apple-icon\.png|icon-192\.png|icon-512\.png|manifest\.webmanifest)$">
    Header set Cache-Control "public, max-age=86400, no-transform"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/calendar application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# Den Zählerstand hält LiteSpeed zwei Sekunden im eigenen Cache (siehe api.php), so bleibt PHP auch bei
# vielen Besucher*innen entspannt.
<IfModule LiteSpeed>
  CacheLookup on
</IfModule>
